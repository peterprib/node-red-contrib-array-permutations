{
  "name": "node-red-contrib-array-permutations",
  "version": "0.0.6",
  "description": "Node-red permutations of an array as repeat or messages.",
  "dependencies": {
    "node-red-contrib-logger": "^0.1.1"
  },
  "devDependencies": {
    "mocha": "^12.0.3",
    "node-red": "^5.0.7",
    "node-red-node-test-helper": "^0.3.6",
    "should": "^13.2.3"
  },
  "scripts": {
    "test": "mocha \"test/**/t*.js\"",
